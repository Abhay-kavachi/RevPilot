# Example Configuration for RevPilot
# Copy this file to .env and adjust as necessary

# Database Configuration (PostgreSQL Required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Razorpay Configuration (Use Test Mode Keys Only)
RAZORPAY_KEY_ID=rzp_test_dummykey
RAZORPAY_KEY_SECRET=rzp_test_dummysecret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhooksecret

# Security Settings
JWT_SECRET_KEY=demo_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
